# Daily CA pipeline service (Railway cron) — SLIM.
# All embedding/ChromaDB/Layer-3 work is precomputed on the Mac night job
# (night_scraper.py → daily_scored_items). This service only authors + formats +
# publishes, so it installs requirements-railway.txt (NO torch/chromadb/sentence-
# transformers) and bakes no model. That is what fixes the OOM (exit 137).
# nixpacks couldn't reliably resolve WeasyPrint's native libs — Docker + apt does.
FROM python:3.11-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# WeasyPrint native libraries (Pango / Cairo / GDK-Pixbuf / HarfBuzz) + Latin fallback fonts.
# (Hindi/Devanagari renders via @font-face from ./fonts committed in the repo.)
RUN apt-get update && apt-get install -y --no-install-recommends \
      libpango-1.0-0 libpangocairo-1.0-0 libcairo2 libgdk-pixbuf-2.0-0 \
      libharfbuzz0b libfontconfig1 libffi-dev \
      fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

# Slim Python deps (weasyprint, flask, anthropic, requests — NO torch/chromadb).
COPY requirements-railway.txt .
RUN pip install -r requirements-railway.txt

# App code
COPY . .

# launch.py routes by SERVICE_MODE: unset/"pipeline" → runs ./pipelines/run_daily.sh
CMD ["python3", "launch.py"]
