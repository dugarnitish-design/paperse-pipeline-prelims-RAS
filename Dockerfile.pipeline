# Daily CA pipeline service (Railway cron).
# nixpacks couldn't reliably resolve WeasyPrint's native libs — Docker + apt does.
# Handles all three heavy deps: WeasyPrint (Pango/Cairo), Playwright+Chromium, torch/chromadb.
FROM python:3.11-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# WeasyPrint native libraries (Pango / Cairo / GDK-Pixbuf / HarfBuzz) + Latin fallback fonts.
# (Hindi/Devanagari renders via @font-face from ./fonts committed in the repo.)
RUN apt-get update && apt-get install -y --no-install-recommends \
      libpango-1.0-0 libpangocairo-1.0-0 libcairo2 libgdk-pixbuf-2.0-0 \
      libharfbuzz0b libfontconfig1 libffi-dev \
      fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

# Python deps (chromadb, sentence-transformers/torch, weasyprint, playwright, etc.)
COPY requirements.txt .
RUN pip install -r requirements.txt

# Playwright Chromium + its OS deps — matches the installed playwright version.
# (PIB scraper needs a real Chromium; Akamai blocks plain-requests/headless.)
RUN python -m playwright install --with-deps chromium

# Pre-download the sentence-transformer model (458 MB) at build time so it is
# baked into the image. Without this every cron run downloads it from HuggingFace
# at runtime — that is 458 MB over Railway's network on every daily cron, takes
# several minutes, and can fail silently, killing the pipeline mid-STEP-2.
RUN python3 -c "\
from sentence_transformers import SentenceTransformer; \
SentenceTransformer('paraphrase-multilingual-MiniLM-L12-v2'); \
print('sentence-transformer model cached in image')"

# App code
COPY . .

# launch.py routes by SERVICE_MODE: unset/"pipeline" → runs ./pipelines/run_daily.sh
CMD ["python3", "launch.py"]
