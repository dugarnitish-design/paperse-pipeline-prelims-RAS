# Curator Flask server — SLIM.
# The publish flow REGENERATES the curated PDF and posts it. PDF regen used to load
# torch/chromadb (find_linked_pyqs) and OOM-killed the 512 MB box → blank "PDF regen
# failed" + 500. Now PYQ matches are precomputed on the Mac (daily_ca_items.pyq), so
# pdf_generator reads them and never loads a model. This image installs
# requirements-railway.txt (NO torch/chromadb/sentence-transformers), bakes no model.
FROM python:3.11-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# WeasyPrint native libraries (Pango / Cairo / GDK-Pixbuf / HarfBuzz) + Latin fonts.
RUN apt-get update && apt-get install -y --no-install-recommends \
      libpango-1.0-0 libpangocairo-1.0-0 libcairo2 libgdk-pixbuf-2.0-0 \
      libharfbuzz0b libfontconfig1 libffi-dev \
      fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

# Slim Python deps (publish regenerates the PDF with weasyprint; PYQ is precomputed
# on the Mac, so NO torch/chromadb/sentence-transformers here).
COPY requirements-railway.txt .
RUN pip install -r requirements-railway.txt

# App code (curator_templates/ etc.; chroma_db/ is .dockerignore'd — unused here)
COPY . .

# launch.py routes by SERVICE_MODE=curator → curator Flask server + schedulers
CMD ["python3", "launch.py"]
